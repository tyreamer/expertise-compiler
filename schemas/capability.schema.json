{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capability",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "string",
      "minLength": 1
    },
    "output_contract": {
      "type": "string",
      "minLength": 1
    },
    "unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "instruction",
          "unit_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "conflict_policy": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "const": "synthetic"
          }
        },
        "required": [
          "input",
          "output",
          "unit_ids",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "title",
    "description",
    "rationale",
    "inputs",
    "output_contract",
    "unit_ids",
    "steps",
    "boundaries",
    "conflict_policy",
    "checks",
    "examples"
  ],
  "additionalProperties": false
}
