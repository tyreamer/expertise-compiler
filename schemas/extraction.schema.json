{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "extraction",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^corpus-[a-f0-9]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src-[a-f0-9]{24}$"
    },
    "note": {
      "type": "string"
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1.0",
            "type": "string"
          },
          "unit_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "type": {
            "enum": [
              "concept",
              "definition",
              "principle",
              "heuristic",
              "procedure",
              "framework",
              "example",
              "warning",
              "failure_pattern",
              "claim",
              "opinion"
            ]
          },
          "status": {
            "enum": [
              "explicit",
              "inferred",
              "synthesized"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "derivation": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^src-[a-f0-9]{24}$"
                },
                "segment_id": {
                  "type": "string",
                  "pattern": "^seg-[0-9]{6}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "segment_id",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "attribution": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^src-[a-f0-9]{24}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "name"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "supports",
                    "contradicts",
                    "requires",
                    "duplicates",
                    "refines"
                  ]
                },
                "target": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 64
                }
              },
              "required": [
                "kind",
                "target"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "schema_version",
          "unit_id",
          "type",
          "status",
          "title",
          "statement",
          "scope",
          "derivation",
          "evidence",
          "attribution",
          "relations"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "source_id",
    "note",
    "units"
  ],
  "additionalProperties": false
}
