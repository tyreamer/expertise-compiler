{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^corpus-[a-f0-9]{64}$"
    },
    "ir_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "object"
    },
    "export_format": {
      "const": "scoped-1"
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "corpus_id",
    "ir_hash",
    "files"
  ],
  "additionalProperties": false
}
