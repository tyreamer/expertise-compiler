{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "collection",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "active_revision": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "revision_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "corpus_id": {
            "type": "string",
            "pattern": "^corpus-[a-f0-9]{64}$"
          },
          "run": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "revision_id",
          "corpus_id",
          "run"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "briefs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "collection_id",
    "name",
    "active_revision",
    "revisions",
    "briefs",
    "builds"
  ],
  "additionalProperties": false
}
