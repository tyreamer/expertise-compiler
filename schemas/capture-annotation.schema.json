{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capture-annotation",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "annotation_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "annotated_at": {
      "type": "string",
      "minLength": 1
    },
    "user_note": {
      "type": "string"
    },
    "add_collections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "annotation_id",
    "capture_id",
    "annotated_at",
    "user_note",
    "add_collections"
  ],
  "additionalProperties": false
}
