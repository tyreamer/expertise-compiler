{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corpus",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^corpus-[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^src-[a-f0-9]{24}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "document_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "source_id",
          "path",
          "document_hash"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "sources"
  ],
  "additionalProperties": false
}
