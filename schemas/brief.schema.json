{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brief",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "work": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "additionalProperties": false
    },
    "desired_result": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "intent": {
      "enum": [
        "create",
        "review",
        "improve",
        "decide",
        "plan",
        "do",
        "learn",
        "reference"
      ]
    },
    "intent_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "objective",
    "context",
    "constraints",
    "work",
    "desired_result",
    "success_criteria"
  ],
  "additionalProperties": false
}
